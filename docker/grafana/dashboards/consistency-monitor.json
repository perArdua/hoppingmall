{
  "uid": "consistency-monitor",
  "title": "Consistency Monitor",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "consistency"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "INV별 확정 위반 건수",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (inv, severity) (invariant_violation_count)",
          "legendFormat": "{{inv}} ({{severity}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "INV별 유예 중 후보 건수",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (inv) (invariant_violation_candidates)",
          "legendFormat": "{{inv}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "가장 오래된 확정 위반 경과(초)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (inv) (invariant_violation_age_seconds_max)",
          "legendFormat": "{{inv}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "1주기 점검 시간(초)",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(invariant_check_cycle_last_duration_seconds)",
          "legendFormat": "cycle"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "점검 쿼리 오류",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (inv) (increase(invariant_check_errors_total[5m]))",
          "legendFormat": "{{inv}}"
        }
      ]
    }
  ]
}
