# .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# docker compose가 이 파일의 값을 읽는다. 값은 따옴표 없이 한 줄로 쓴다.
# 비밀값은 무작위로 만든 긴 문자열을 쓴다(예: `openssl rand -hex 32`의 출력). 이 파일에는 실제 값을 적지 않는다.

# ===== 필수: 하나라도 비어 있으면 docker compose가 ".env에 <이름>을 설정하세요"를 내고 아무것도 띄우지 않는다 =====

# MySQL root 비밀번호. mysql 컨테이너와 여섯 서비스·consistency-monitor·seed-runner가 DB에 접속할 때 쓴다.
# mysql 볼륨을 처음 만들 때만 DB에 들어간다. 그 뒤에 이 값만 바꾸면 서비스가 DB에 접속하지 못한다(DB에서 직접 바꾸거나 볼륨을 새로 만든다).
MYSQL_ROOT_PASSWORD=

# 서비스끼리 내부 API·gRPC를 부를 때 붙이는 토큰. user·product·order·payment·settlement가 같은 값을 쓴다.
# 서비스마다 값이 다르면 서비스 사이 호출이 인증 실패로 거절된다.
INTERNAL_SERVICE_TOKEN=

# 게이트웨이가 사용자 신원 헤더에 함께 붙이는 증명 값. api-gateway와 여섯 서비스가 같은 값을 쓴다.
# 서비스는 docker·k8s 프로필에서 이 값이 없으면 기동하지 않고, 게이트웨이와 값이 다르면 로그인한 요청도 인증되지 않은 요청으로 처리된다.
GATEWAY_IDENTITY_SECRET=

# 로그인 토큰(JWT) 서명 키. user-service가 서명하고 api-gateway·consistency-monitor가 검증한다.
# 32바이트(영문·숫자 32자)보다 짧으면 서명 키를 만들지 못해 이 서비스들이 뜨지 않는다. 바꾸면 이미 발급된 토큰은 모두 받지 않는다.
JWT_SECRET=

# Grafana admin 계정 비밀번호(127.0.0.1:3000 로그인).
GRAFANA_ADMIN_PASSWORD=

# MinIO(상품 이미지 저장소) 관리자 비밀번호. 8자 이상. minio와 minio-init이 쓴다.
# minio 볼륨을 처음 만들 때 들어간다. 그 뒤에 바꾸려면 MinIO에서 직접 바꾸거나 볼륨을 새로 만든다.
MINIO_ROOT_PASSWORD=

# product-service가 MinIO에 이미지를 올리고 지울 때 쓰는 비밀 키. 8자 이상.
# minio-init이 이 값으로 product-service 전용 사용자(버킷 hoppingmall-product의 올리기·읽기·지우기만)를 만든다.
STORAGE_SECRET_KEY=

# ===== 선택: 줄을 지우거나 값을 비워도 기동한다 =====

# 게이트웨이가 CORS를 허용할 출처. 비우면 http://localhost:3000.
# CORS_ALLOWED_ORIGINS=

# user-service가 리프레시 토큰 쿠키 방식(X-Token-Transport: cookie) 요청을 받는 출처. 비우면 http://localhost:3000.
# CORS_ALLOWED_ORIGINS와 같은 값을 넣는다. 다르면 프론트의 쿠키 방식 재발급·로그아웃이 403으로 거절된다.
# AUTH_REFRESHCOOKIE_ALLOWEDORIGINS=https://shop.example.com

# MinIO 관리자 이름. 비우면 hoppingmall-root.
# MINIO_ROOT_USER=

# product-service의 MinIO 접근 키(사용자 이름). 비우면 product-service.
# STORAGE_ACCESS_KEY=

# MinIO를 여는 호스트 포트. 비우면 9000. 바꾸면 STORAGE_PUBLIC_BASE_URL의 포트도 같게 바꾼다.
# MINIO_PORT=

# 브라우저가 상품 이미지를 읽는 주소의 앞부분(버킷까지). 비우면 http://localhost:9000/hoppingmall-product.
# 업로드 응답과 상품 응답의 이미지 주소가 이 값으로 시작하고, 상품 등록·수정은 이 값으로 시작하는 주소만 받는다.
# STORAGE_PUBLIC_BASE_URL=

# 신원 증명 값을 바꾸는 동안만 서비스가 함께 받는 이전 값. 평소에는 비워 둔다.
# 바꾸는 순서: 서비스에 새 값을 GATEWAY_IDENTITY_SECRET, 옛 값을 여기에 넣고 재시작 → 게이트웨이를 새 값으로 재시작 → 여기를 비우고 서비스 재시작.
# GATEWAY_IDENTITY_PREVIOUS_SECRET=
